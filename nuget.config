<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Central package management warns when more than one source is defined, so restores use nuget.org alone. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
