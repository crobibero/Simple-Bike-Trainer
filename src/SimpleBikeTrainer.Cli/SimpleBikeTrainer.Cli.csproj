<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>simple-bike-trainer-cli</AssemblyName>
    <RootNamespace>SimpleBikeTrainer</RootNamespace>
    <StringsClassName>CliStrings</StringsClassName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleBikeTrainer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <!--
    Trimmed and native AOT builds. Tmds.DBus, which Linux.Bluetooth and KeepAwake use, makes its D-Bus proxies with
    Reflection.Emit: trimming them silently breaks the Bluetooth scan, and native AOT cannot run them at all. Rooting the
    three assemblies keeps a trimmed Linux build working; their remaining trim and AOT warnings stay warnings.
    Spectre.Console.Cli reads each command's settings type, and the settings' options, by reflection: trimmed, it
    cannot start. Rooting it and this assembly, which holds the commands, keeps them.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Tmds.DBus" />
    <TrimmerRootAssembly Include="Linux.Bluetooth" />
    <TrimmerRootAssembly Include="SimpleBikeTrainer.Core" />
    <TrimmerRootAssembly Include="Spectre.Console.Cli" />
    <TrimmerRootAssembly Include="$(AssemblyName)" />
  </ItemGroup>

  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SimpleBikeTrainer.Core/SimpleBikeTrainer.Core.csproj" />
  </ItemGroup>

</Project>
