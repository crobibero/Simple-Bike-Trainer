<Project>

  <PropertyGroup>
    <SupportedOSPlatformVersion>31</SupportedOSPlatformVersion>
    <ApplicationId>dev.codyrobibero.simplebiketrainer</ApplicationId>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidManifest>Platforms/Android/AndroidManifest.xml</AndroidManifest>
    <MonoAndroidResourcePrefix>Platforms/Android/Resources</MonoAndroidResourcePrefix>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
    <Using Remove="Android.OS.Bundle" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <!-- Required for https requests -->
    <IlcArg Include="--export-dynamic-symbol:Java_net_dot_android_crypto_DotnetProxyTrustManager_verifyRemoteCertificate" />
    <IlcArg Include="--runtimeopt:GCgen0size=1000000" />
  </ItemGroup>

  <Target Name="_SkipAbiLessNativeBinary" BeforeTargets="CopyNativeBinary;_CopyAotSymbols" Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <NativeBinary />
      <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    </PropertyGroup>
  </Target>

</Project>
