<Application x:Class="SimpleBikeTrainer.Desktop.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SimpleBikeTrainer.Desktop"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             Name="Simple Bike Trainer"
             RequestedThemeVariant="Default">
    <!--  "Default" follows the system's light or dark setting.  -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <shadui:ShadTheme />
        <StyleInclude Source="avares://simple-bike-trainer/Theme.axaml" />
    </Application.Styles>
</Application>
