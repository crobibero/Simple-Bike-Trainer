<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The single TargetFramework from Directory.Build.props is cleared so the build runs once per framework. -->
    <TargetFrameworks Condition="'$(AndroidBuild)' == 'true' Or '$(IosBuild)' == 'true'">$(AppTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(AndroidBuild)' == 'true'">$(TargetFrameworks);$(AndroidTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(IosBuild)' == 'true'">$(TargetFrameworks);$(IosTargetFramework)</TargetFrameworks>
    <TargetFramework Condition="'$(AndroidBuild)' == 'true' Or '$(IosBuild)' == 'true'" />
    <IsAndroid>false</IsAndroid>
    <IsAndroid Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">true</IsAndroid>
    <IsIos>false</IsIos>
    <IsIos Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'ios'">true</IsIos>
    <IsMobile>false</IsMobile>
    <IsMobile Condition="'$(IsAndroid)' == 'true' Or '$(IsIos)' == 'true'">true</IsMobile>
    <AssemblyName>simple-bike-trainer</AssemblyName>
    <RootNamespace>SimpleBikeTrainer.Desktop</RootNamespace>
    <StringsClassName>Strings</StringsClassName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Analyzers flag code that would break in trimmed or native AOT builds. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <!-- The .exe's icon on Windows. The window sets its own from the same file. -->
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleBikeTrainer.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsyncAwaitBestPractices" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="ShadUI" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsMobile)' != 'true'">
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <!--
    Trimmed and native AOT builds. Tmds.DBus, which Linux.Bluetooth and KeepAwake use, makes its D-Bus proxies with
    Reflection.Emit: trimming them silently breaks the Bluetooth scan, and native AOT cannot run them at all. Rooting the
    three assemblies keeps a trimmed Linux build working; their remaining trim and AOT warnings stay warnings.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Tmds.DBus" RootMode="All" Condition="'$(IsMobile)' != 'true'" />
    <TrimmerRootAssembly Include="Linux.Bluetooth" RootMode="All" Condition="'$(IsMobile)' != 'true'" />
    <TrimmerRootAssembly Include="SimpleBikeTrainer.Core" RootMode="All" />
  </ItemGroup>

  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SimpleBikeTrainer.Core/SimpleBikeTrainer.Core.csproj" />
  </ItemGroup>

  <!--
    The Android tablet app: the same app in one full-screen view, with Bluetooth and the ANT+ stick through Android's
    own APIs (Platforms/Android). Program.cs, the desktop entry point, is left out.
  -->
  <PropertyGroup Condition="'$(IsAndroid)' == 'true'">
    <OutputType>Exe</OutputType>
    <!-- Android 12: the Bluetooth permissions it brought in need no location permission. -->
    <SupportedOSPlatformVersion>31</SupportedOSPlatformVersion>
    <ApplicationId>dev.codyrobibero.simplebiketrainer</ApplicationId>
    <ApplicationTitle>Simple Bike Trainer</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidManifest>Platforms/Android/AndroidManifest.xml</AndroidManifest>
    <MonoAndroidResourcePrefix>Platforms/Android/Resources</MonoAndroidResourcePrefix>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsAndroid)' == 'true'">
    <PackageReference Include="Avalonia.Android" />
    <Compile Remove="Program.cs" />
    <!-- Android's global usings clash with Avalonia's names, such as Application, in the shared code. -->
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
    <Using Remove="Android.OS.Bundle" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsAndroid)' != 'true'">
    <Compile Remove="Platforms/Android/**" />
    <None Include="Platforms/Android/**" />
  </ItemGroup>

  <!-- The iPad app, as on Android (Platforms/iOS), with Bluetooth through the CoreBluetooth code the macOS app uses. -->
  <PropertyGroup Condition="'$(IsIos)' == 'true'">
    <OutputType>Exe</OutputType>
    <!-- Avalonia's Metal renderer. -->
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>dev.codyrobibero.SimpleBikeTrainer</ApplicationId>
    <ApplicationTitle>Simple Bike Trainer</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AppIcon>AppIcon</AppIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsIos)' == 'true'">
    <PackageReference Include="Avalonia.iOS" />
    <Compile Remove="Program.cs" />
    <None Update="Platforms/iOS/Info.plist" LogicalName="Info.plist" />
    <!-- As on Android, the global usings would clash with Avalonia's names in the shared code. -->
    <Using Remove="CoreGraphics" />
    <Using Remove="Foundation" />
    <Using Remove="UIKit" />
    <ImageAsset Include="Platforms/iOS/Assets.xcassets/**" Exclude="Platforms/iOS/Assets.xcassets/**/.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsIos)' != 'true'">
    <Compile Remove="Platforms/iOS/**" />
    <None Include="Platforms/iOS/**" />
  </ItemGroup>

</Project>
