<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks Condition="'$(AndroidBuild)' == 'true' Or '$(IosBuild)' == 'true'">$(AppTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(AndroidBuild)' == 'true'">$(TargetFrameworks);$(AndroidTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(IosBuild)' == 'true'">$(TargetFrameworks);$(IosTargetFramework)</TargetFrameworks>
    <TargetFramework Condition="'$(TargetFrameworks)' != ''" />
    <IsAndroid Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">true</IsAndroid>
    <IsIos Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'ios'">true</IsIos>
    <IsMobile Condition="'$(IsAndroid)' == 'true' Or '$(IsIos)' == 'true'">true</IsMobile>
    <AssemblyName>simple-bike-trainer</AssemblyName>
    <StringsClassName>Strings</StringsClassName>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2037;IL2104;IL3053</WarningsNotAsErrors>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleBikeTrainer.Desktop.Tests" />
    <ProjectReference Include="../SimpleBikeTrainer.Core/SimpleBikeTrainer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="ONEO.FluentUIIconsLike" />
    <PackageReference Include="ONEO.FluentUIIconsLike.Generator" PrivateAssets="all" />
    <PackageReference Include="ShadUI" />
    <PackageReference Include="Avalonia.Desktop" Condition="'$(IsMobile)' != 'true'" />
    <PackageReference Include="StaticLink.Avalonia" Condition="$(RuntimeIdentifier.StartsWith('win-')) Or $(RuntimeIdentifier.StartsWith('linux-'))" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsMobile)' == 'true'">
    <OutputType>Exe</OutputType>
    <ApplicationTitle>Simple Bike Trainer</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Program.cs" Condition="'$(IsMobile)' == 'true'" />
    <Compile Remove="Platforms/Android/**" Condition="'$(IsAndroid)' != 'true'" />
    <None Include="Platforms/Android/**" Condition="'$(IsAndroid)' != 'true'" />
    <Compile Remove="Platforms/iOS/**" Condition="'$(IsIos)' != 'true'" />
    <None Include="Platforms/iOS/**" Condition="'$(IsIos)' != 'true'" />
  </ItemGroup>

  <Import Project="Platforms/Android/Android.props" Condition="'$(IsAndroid)' == 'true'" />
  <Import Project="Platforms/iOS/iOS.props" Condition="'$(IsIos)' == 'true'" />

</Project>
