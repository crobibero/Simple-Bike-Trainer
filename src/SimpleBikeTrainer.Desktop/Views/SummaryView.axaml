<UserControl x:Class="SimpleBikeTrainer.Desktop.Views.SummaryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:SimpleBikeTrainer.Desktop.Controls"
             xmlns:icons="https://github.com/oneo-me/fluentui-icons-like"
             xmlns:r="using:SimpleBikeTrainer.Desktop.Resources"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:v="using:SimpleBikeTrainer.Desktop.Views"
             xmlns:vm="using:SimpleBikeTrainer.Desktop.ViewModels"
             x:DataType="vm:SummaryViewModel">
    <ScrollViewer>
        <StackPanel Margin="24"
                    Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal"
                            Spacing="14">
                    <Path Width="44"
                          Height="44"
                          Classes="bike" />
                    <StackPanel Spacing="4">
                        <TextBlock Classes="h1"
                                   Text="{Binding Title}" />
                        <TextBlock Classes="muted"
                                   Text="{Binding Subtitle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                    <Button AutomationProperties.Name="{x:Static r:Strings.Common_HelpTip}"
                            Classes="help Ghost"
                            Command="{Binding $parent[v:MainView].((vm:MainWindowViewModel)DataContext).ShowHelpCommand}"
                            ToolTip.Tip="{x:Static r:Strings.Common_HelpTip}">
                        <icons:FluentIcon Size="Size24"
                                          Symbol="QuestionCircle" />
                    </Button>
                    <Button Classes="Outline"
                            Command="{Binding OpenFolderCommand}"
                            Content="{x:Static vm:SummaryViewModel.FitButtonText}"
                            IsVisible="{Binding HasFit}" />
                    <Button Classes="Primary"
                            Command="{Binding DoneCommand}"
                            Content="{x:Static r:Strings.Summary_Done}" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Headline}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Margin="-6,0"
                                     Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatRow">
                        <Border Margin="6"
                                Classes="card"
                                ToolTip.Tip="{Binding Tip}">
                            <StackPanel>
                                <TextBlock Classes="label"
                                           Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="medium"
                                           Text="{Binding Value}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Padding="12"
                    Classes="card">
                <StackPanel Spacing="8">
                    <c:WorkoutChart Height="220"
                                    Ftp="{Binding Ftp}"
                                    Points="{Binding Points}"
                                    Position="{Binding ChartEnd}"
                                    Workout="{Binding Workout}" />
                    <v:ChartLegend Margin="4,0,0,0"
                                   IsRoute="{Binding IsRoute}" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*">
                <StackPanel Margin="0,0,16,0"
                            Spacing="16">
                    <!--  Uploads  -->
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="label"
                                       Text="{x:Static r:Strings.Summary_Upload}" />
                            <ItemsControl ItemsSource="{Binding Uploads}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UploadRow">
                                        <Grid Margin="0,4"
                                              ColumnDefinitions="Auto,*,Auto">
                                            <!--  The name is the check box's content, so it gets the box's spacing and toggles it.  -->
                                            <CheckBox Margin="0,0,16,0"
                                                      Content="{Binding Name}"
                                                      FontWeight="SemiBold"
                                                      IsChecked="{Binding Selected}"
                                                      IsEnabled="{Binding Available}" />
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="8">
                                                <shadui:Loading Width="20"
                                                                Height="20"
                                                                IsVisible="{Binding IsBusy}" />
                                                <TextBlock Foreground="{Binding StatusBrush}"
                                                           Text="{Binding Status}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Classes="Outline"
                                                    Command="{Binding $parent[UserControl].((vm:SummaryViewModel)DataContext).OpenUrlCommand}"
                                                    CommandParameter="{Binding Url}"
                                                    Content="{x:Static r:Strings.Summary_Open}"
                                                    IsVisible="{Binding HasUrl}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button HorizontalAlignment="Left"
                                    Classes="Primary"
                                    Command="{Binding UploadCommand}"
                                    Content="{x:Static r:Strings.Summary_UploadSelected}" />
                        </StackPanel>
                    </Border>

                    <!--  Ramp test FTP  -->
                    <Border Classes="card"
                            IsVisible="{Binding HasFtpEstimate}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="label"
                                       Text="{x:Static r:Strings.Common_Ftp}" />
                            <TextBlock Text="{Binding FtpText}"
                                       TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left"
                                    Classes="Outline"
                                    Command="{Binding SetFtpCommand}"
                                    Content="{x:Static r:Strings.Summary_SetFtp}" />
                            <TextBlock Classes="muted"
                                       Text="{Binding FtpStatus}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  Laps  -->
                    <Border Classes="card"
                            IsVisible="{Binding HasLaps}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label"
                                       Text="{x:Static r:Strings.Summary_Laps}" />
                            <Grid ColumnDefinitions="40,*,*,*,*,*,*">
                                <TextBlock Classes="muted"
                                           Text="{x:Static r:Strings.Summary_LapNumber}" />
                                <TextBlock Grid.Column="1"
                                           Classes="muted"
                                           Text="{x:Static r:Strings.Common_Time}" />
                                <TextBlock Grid.Column="2"
                                           Classes="muted"
                                           Text="{x:Static r:Strings.Summary_AvgW}" />
                                <TextBlock Grid.Column="3"
                                           Classes="muted"
                                           Text="{x:Static r:Strings.Summary_MaxW}" />
                                <TextBlock Grid.Column="4"
                                           Classes="muted"
                                           Text="{x:Static r:Strings.Common_AvgHr}" />
                                <TextBlock Grid.Column="5"
                                           Classes="muted"
                                           Text="{x:Static r:Strings.Common_Cadence}" />
                                <TextBlock Grid.Column="6"
                                           Classes="muted"
                                           Text="{x:Static r:Strings.Common_OnTarget}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Laps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LapRow">
                                        <Grid Margin="0,2"
                                              ColumnDefinitions="40,*,*,*,*,*,*">
                                            <TextBlock Text="{Binding Number}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Time}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AvgPower}" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding MaxPower}" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding AvgHr}" />
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding AvgCadence}" />
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding OnTarget}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1"
                        VerticalAlignment="Top"
                        Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label"
                                   Text="{x:Static r:Strings.Summary_Details}" />
                        <ItemsControl ItemsSource="{Binding Stats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatRow">
                                    <Grid Margin="0,3"
                                          ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="muted"
                                                   Text="{Binding Label}"
                                                   ToolTip.Tip="{Binding Tip}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="stat"
                                                   Text="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
