<UserControl x:Class="SimpleBikeTrainer.Desktop.Views.ChartLegend"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="using:SimpleBikeTrainer.Desktop.Resources"
             xmlns:v="using:SimpleBikeTrainer.Desktop.Views">
    <!--  What the lines and colors on the workout chart mean. Help explains the rest.  -->
    <WrapPanel Orientation="Horizontal">
        <WrapPanel.Styles>
            <Style Selector="StackPanel.item">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="6" />
                <Setter Property="Margin" Value="0,2,18,2" />
            </Style>
            <Style Selector="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource MutedColor}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="Line">
                <Setter Property="StartPoint" Value="0,6" />
                <Setter Property="EndPoint" Value="18,6" />
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="12" />
                <Setter Property="StrokeThickness" Value="2" />
            </Style>
            <Style Selector="Border.zone">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="10" />
                <Setter Property="CornerRadius" Value="2" />
            </Style>
        </WrapPanel.Styles>

        <StackPanel Classes="item"
                    IsVisible="{Binding $parent[v:ChartLegend].IsRoute}"
                    ToolTip.Tip="{x:Static r:Strings.Legend_RouteTip}">
            <StackPanel VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                <Border Background="#3B8EEA"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Downhill}" />
                <Border Background="#8C95A3"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Flat}" />
                <Border Background="#4CC38A"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Grade2}" />
                <Border Background="#F2C14E"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Grade4}" />
                <Border Background="#FF8C42"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Grade6}" />
                <Border Background="#F0565A"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Grade9}" />
            </StackPanel>
            <TextBlock Text="{x:Static r:Strings.Legend_Elevation}" />
        </StackPanel>
        <StackPanel Classes="item"
                    IsVisible="{Binding !$parent[v:ChartLegend].IsRoute}"
                    ToolTip.Tip="{x:Static r:Strings.Legend_StepsTip}">
            <StackPanel VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                <Border Background="#8C95A3"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Z1}" />
                <Border Background="#3B8EEA"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Z2}" />
                <Border Background="#4CC38A"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Z3}" />
                <Border Background="#F2C14E"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Z4}" />
                <Border Background="#FF8C42"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Z5}" />
                <Border Background="#F0565A"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Z6}" />
                <Border Background="#B26BF0"
                        Classes="zone"
                        ToolTip.Tip="{x:Static r:Strings.Legend_Z7}" />
            </StackPanel>
            <TextBlock Text="{x:Static r:Strings.Legend_Target}" />
        </StackPanel>
        <StackPanel Classes="item">
            <Line Stroke="{DynamicResource TraceBrush}" />
            <TextBlock Text="{x:Static r:Strings.Legend_Power}" />
        </StackPanel>
        <StackPanel Classes="item"
                    ToolTip.Tip="{x:Static r:Strings.Legend_HeartRateTip}">
            <Line Stroke="{DynamicResource HeartBrush}" />
            <TextBlock Text="{x:Static r:Strings.Common_HeartRate}" />
        </StackPanel>
        <StackPanel Classes="item"
                    IsVisible="{Binding !$parent[v:ChartLegend].IsRoute}"
                    ToolTip.Tip="{x:Static r:Strings.Legend_GradeTip}">
            <Line Stroke="{DynamicResource GradeBrush}" />
            <TextBlock Text="{x:Static r:Strings.Common_Grade}" />
        </StackPanel>
        <StackPanel Classes="item"
                    ToolTip.Tip="{x:Static r:Strings.Legend_FtpTip}">
            <Line Stroke="{DynamicResource FtpLineBrush}"
                  StrokeDashArray="2,2" />
            <TextBlock Text="{x:Static r:Strings.Common_Ftp}" />
        </StackPanel>
        <StackPanel Classes="item">
            <Line Width="12"
                  Stroke="{DynamicResource PrimaryColor}"
                  StartPoint="6,0"
                  EndPoint="6,12" />
            <TextBlock Text="{x:Static r:Strings.Legend_Now}" />
        </StackPanel>
    </WrapPanel>
</UserControl>
