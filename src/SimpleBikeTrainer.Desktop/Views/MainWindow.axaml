<shadui:Window x:Class="SimpleBikeTrainer.Desktop.Views.MainWindow"
               xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
               xmlns:v="using:SimpleBikeTrainer.Desktop.Views"
               xmlns:vm="using:SimpleBikeTrainer.Desktop.ViewModels"
               Title="{Binding Title}"
               Width="1440"
               Height="900"
               MinWidth="1100"
               MinHeight="720"
               x:DataType="vm:MainWindowViewModel"
               Icon="/Assets/icon.ico"
               TitleFontWeight="SemiBold">
    <v:MainView />
</shadui:Window>
