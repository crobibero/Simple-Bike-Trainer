<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers flag code that would break in trimmed or native AOT builds of the apps. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- CoreBluetooth and libusb are called through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SimpleBikeTrainer</RootNamespace>
    <StringsClassName>CoreStrings</StringsClassName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleBikeTrainer.Tests" />
    <InternalsVisibleTo Include="simple-bike-trainer-cli" />
    <!-- The Android app plugs its own Bluetooth and USB code into BleAdapter.PlatformOpen and AntStick.OpenTransport. -->
    <InternalsVisibleTo Include="simple-bike-trainer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsyncAwaitBestPractices" />
    <PackageReference Include="Garmin.FIT.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Tmds.DBus.Generator" PrivateAssets="all" />
  </ItemGroup>

  <!-- D-Bus proxies for BlueZ and the screensaver, written at build time so trimmed and native AOT builds keep them. -->
  <ItemGroup>
    <AdditionalFiles Include="Ble/BlueZ/BlueZ.xml" DBusGeneratorMode="Proxy" Namespace="SimpleBikeTrainer.Ble.BlueZ" />
    <AdditionalFiles Include="Platform/KeepAwake.xml" DBusGeneratorMode="Proxy" Namespace="SimpleBikeTrainer.Platform" />
  </ItemGroup>

</Project>
