<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The publish workflow replaces VERSION. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Simple Bike Trainer</string>
    <key>CFBundleDisplayName</key>
    <string>Simple Bike Trainer</string>
    <key>CFBundleIdentifier</key>
    <string>dev.codyrobibero.SimpleBikeTrainer</string>
    <key>CFBundleExecutable</key>
    <string>simple-bike-trainer</string>
    <key>CFBundleIconFile</key>
    <string>icon.icns</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>VERSION</string>
    <key>CFBundleShortVersionString</key>
    <string>VERSION</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Without it, macOS ends the app the first time it uses Bluetooth. -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Simple Bike Trainer connects to your trainer, heart rate monitor, and Zwift controllers over Bluetooth.</string>
    <!-- Without these, macOS silently blocks the mDNS scan and the connection to a Wi-Fi trainer. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Simple Bike Trainer finds and connects to Wi-Fi trainers on your local network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_wahoo-fitness-tnp._tcp</string>
    </array>
</dict>
</plist>
